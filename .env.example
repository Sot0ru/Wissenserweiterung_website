# Kopiere diese Datei nach .env, wenn du etwas anpassen willst.

# Welche KI schreibt die Artikel? "ollama" (kostenlos, lokal) oder "claude" (kostenpflichtig)
KI_ANBIETER=ollama

# Lokales Open-Source-Modell für Ollama, z. B. gemma4:e4b, gemma4:12b oder qwen3.5:9b
OLLAMA_MODEL=gemma4:e4b

# Nur für Claude nötig. Schlüssel gibt es unter https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
